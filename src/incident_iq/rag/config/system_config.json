{
  "database": {
    "path": "src/incident_iq/database/data/incident_iq.db",
    "connection_timeout": 30,
    "check_same_thread": false
  },
  "departments": {
    "engineering": {
      "keywords": ["deployment", "kubernetes", "api", "database", "server", "infrastructure", "code"],
      "access_level": 2,
      "allowed_roles": ["admin", "security_admin", "executive", "engineering_lead", "engineer"]
    },
    "security": {
      "keywords": ["security", "breach", "vulnerability", "firewall", "encryption", "threat"],
      "access_level": 1,
      "allowed_roles": ["admin", "security_admin", "executive", "senior_manager"]
    },
    "finance": {
      "keywords": ["payment", "revenue", "financial", "transaction", "billing", "budget"],
      "access_level": 1,
      "allowed_roles": ["admin", "executive", "senior_manager"]
    },
    "hr": {
      "keywords": ["employee", "onboarding", "hiring", "payroll", "benefits", "training"],
      "access_level": 3,
      "allowed_roles": ["admin", "executive", "senior_manager", "hr_manager"]
    }
  },
  "roles": {
    "admin": {
      "display_name": "Administrator",
      "description": "Full access to all data",
      "access_level": 1
    },
    "security_admin": {
      "display_name": "Security Admin",
      "description": "Access to security & sensitive data",
      "access_level": 1
    },
    "executive": {
      "display_name": "Executive",
      "description": "High-level access",
      "access_level": 1
    },
    "senior_manager": {
      "display_name": "Senior Manager",
      "description": "Manager + sensitive data",
      "access_level": 2
    },
    "manager": {
      "display_name": "Manager",
      "description": "Team data access",
      "access_level": 3
    },
    "engineer": {
      "display_name": "Engineer",
      "description": "Technical data access",
      "access_level": 4
    },
    "employee": {
      "display_name": "Employee",
      "description": "General access",
      "access_level": 4
    }
  },
  "retrieval": {
    "default_top_k": 5,
    "default_similarity_threshold": 0.3,
    "max_top_k": 20
  },
  "system": {
    "log_level": "INFO",
    "enable_debug": false,
    "max_workers": 4,
    "timeout": 30
  }
}
