{
  "role_mappings": {
    "111": {
      "company_id": 1,
      "company_name": "Acme Corp",
      "department_id": 1,
      "department_name": "General",
      "role_id": 1,
      "role_name": "Public Access",
      "access_level": 1,
      "can_access": ["public"]
    },
    "112": {
      "company_id": 1,
      "company_name": "Acme Corp",
      "department_id": 1,
      "department_name": "HR",
      "role_id": 2,
      "role_name": "Associate",
      "access_level": 2,
      "can_access": ["public", "internal_hr", "company_handbook"]
    },
    "121": {
      "company_id": 1,
      "company_name": "Acme Corp",
      "department_id": 2,
      "department_name": "Engineering",
      "role_id": 3,
      "role_name": "Engineer",
      "access_level": 3,
      "can_access": ["public", "internal_engineering", "technical_docs", "api_docs"]
    }
  },
  "subject_areas": {
    "engineering": {
      "keywords": ["API", "architecture", "code", "deployment", "infrastructure", "technical", "system", "database"],
      "default_departments": [2]
    },
    "hr": {
      "keywords": ["employee", "policy", "handbook", "benefits", "compensation", "performance", "hiring"],
      "default_departments": [1]
    },
    "finance": {
      "keywords": ["revenue", "expense", "budget", "financial", "accounting", "invoice", "payment"],
      "default_departments": [3]
    },
    "general": {
      "keywords": ["overview", "about", "mission", "vision", "values", "company"],
      "default_departments": [1]
    }
  },
  "sensitivity_levels": {
    "public": {
      "level": 1,
      "description": "Publicly available information",
      "min_role_id": 1
    },
    "internal": {
      "level": 2,
      "description": "Internal company information",
      "min_role_id": 2
    },
    "confidential": {
      "level": 3,
      "description": "Confidential business information",
      "min_role_id": 3
    },
    "legal": {
      "level": 4,
      "description": "Legally protected information",
      "min_role_id": 3
    },
    "highly_confidential": {
      "level": 5,
      "description": "Highly sensitive information",
      "min_role_id": 4
    }
  },
  "access_rules": {
    "default_access": {
      "public": [1, 2, 3, 4, 5],
      "internal": [2, 3, 4, 5],
      "confidential": [3, 4, 5],
      "legal": [3, 4, 5],
      "highly_confidential": [4, 5]
    }
  },
  "audit": {
    "log_access_attempts": true,
    "log_denied_access": true,
    "retention_days": 365,
    "alert_on_violations": true,
    "alert_threshold": 5
  },
  "agent_config": {
    "ingestion": {
      "auto_classify": true,
      "confidence_threshold": 0.7,
      "fallback_sensitivity": "internal",
      "human_review_required": false
    },
    "retrieval": {
      "strict_mode": true,
      "cache_permissions": true,
      "cache_ttl_seconds": 300,
      "log_all_checks": true
    }
  }
}
